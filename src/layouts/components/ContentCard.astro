---
import { cfImage } from "@lib/utils/cfImage";
import { colorForCategory, mainCategory } from "@lib/utils/categoryColors";
import { humanize } from "@lib/utils/textConverter";
import dateFormat from "@lib/utils/dateFormat";

interface Props {
  href: string;
  image?: { url: string; alt: string };
  category?: string;
  categories: string[];
  title: string;
  excerpt: string;
  date: string;
  meta?: { readingTime?: string; author?: string };
  hasPdf?: boolean;
  ctaLabel?: string;
}

const {
  href,
  image,
  category,
  categories,
  title,
  excerpt,
  date,
  meta,
  hasPdf = false,
  ctaLabel = "Découvrir",
} = Astro.props;

const cat = category ?? mainCategory(category ?? "");
const badgeColor = cat ? colorForCategory(cat, categories) : "#24A1FF";
---

<div class="group flex h-full flex-col overflow-hidden rounded-xl bg-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
  <a href={href} class="block overflow-hidden">
    {image?.url ? (
      <img
        class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105"
        src={cfImage(image.url, { w: 640, h: 400 })}
        alt={image.alt}
        loading="lazy"
      />
    ) : (
      <div class="aspect-[16/10] w-full bg-theme-light" />
    )}
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-center gap-x-3">
      {cat && (
        <span
          class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-white"
          style={`background-color: ${badgeColor}`}
        >
          {humanize(cat)}
        </span>
      )}
      {hasPdf && (
        <svg class="text-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" title="PDF disponible">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      )}
    </div>
    <h3 class="h5">
      <a href={href} class="transition-colors hover:text-primary">{title}</a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm text-text">{excerpt}</p>
    {meta?.author && (
      <p class="mt-2 text-xs text-light">{humanize(meta.author)}{meta.readingTime ? ` · ${meta.readingTime}` : ""}</p>
    )}
    <div class="mt-auto flex items-center justify-between pt-6">
      <span class="inline-flex items-center text-sm text-light">
        <svg class="mr-1.5" width="14" height="14" viewBox="0 0 14 16" fill="none">
          <path d="M12.5 2H11V0.375C11 0.16875 10.8313 0 10.625 0H9.375C9.16875 0 9 0.16875 9 0.375V2H5V0.375C5 0.16875 4.83125 0 4.625 0H3.375C3.16875 0 3 0.16875 3 0.375V2H1.5C0.671875 2 0 2.67188 0 3.5V14.5C0 15.3281 0.671875 16 1.5 16H12.5C13.3281 16 14 15.3281 14 14.5V3.5C14 2.67188 13.3281 2 12.5 2ZM12.3125 14.5H1.6875C1.58438 14.5 1.5 14.4156 1.5 14.3125V5H12.5V14.3125C12.5 14.4156 12.4156 14.5 12.3125 14.5Z" fill="#939393"/>
        </svg>
        {dateFormat(date)}
      </span>
      <a class="inline-flex items-center font-semibold text-primary" href={href}>
        {ctaLabel}
        <svg class="ml-1.5 transition-transform group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</div>
