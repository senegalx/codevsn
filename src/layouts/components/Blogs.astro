---
import ContentCard from "@layouts/components/ContentCard.astro";
import { plainify } from "@lib/utils/textConverter";
import { mainCategory } from "@lib/utils/categoryColors";

const { posts } = Astro.props;

// Fetch categories for color palette
import { getCategories } from "../../lib/publicationParser.astro";
const categories = await getCategories();
---

<div class="row">
  {
    posts.map((item: any) => {
      const cat = mainCategory(item.categories);
      const excerpt = plainify(item.contenu ?? "").slice(0, 200);
      const imageUrl = item.image?.fields?.file?.url;
      const imageAlt = item.image?.fields?.file?.fileName || item.title;
      return (
        <div class="mb-8 md:col-6 lg:col-4">
          <ContentCard
            href={`/actualites/${item.slug}`}
            image={imageUrl ? { url: imageUrl, alt: imageAlt } : undefined}
            category={cat}
            categories={categories}
            title={item.title}
            excerpt={excerpt}
            date={item.date}
            meta={{ author: item.author }}
            ctaLabel="Découvrir"
          />
        </div>
      );
    })
  }
</div>
